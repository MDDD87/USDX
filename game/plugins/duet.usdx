-- Party mode "Duet" (SingStar style):
-- Duet (Feature 4, SingStar principle): two members of each team sing a
-- duet together, the teams sing the same duet song one after another. The
-- team score is the average of both voices. The whole duet counts as one
-- party round.
--
-- This plugin only registers the round type. The round itself is played by
-- the game (TPartyGame.PrepareDuetRound, ScreenPartyNewRound, ...), which
-- recognizes the mode by its name 'Duet'. It is offered only if every team
-- has at least two players and the party song pool contains a duet song.

function plugin_init()
  register('party mode: duet', '1.00', 'USDX Team', 'http://www.UltrastarDeluxe.org');

  require('Usdx.Party')

  local Mode = {}

  Mode.Name = 'Duet'
  Mode.CanNonParty = false;
  Mode.CanParty = true;

  Usdx.Party.Register(Mode)

  return true;
end
