-- Party mode "Micro-Medley" (SingStar style):
-- one person per team sings the same sequence of up to 8 short song sections
-- (about 15 seconds each). The average score over all sections decides
-- the round. The whole medley counts as one party round.
--
-- This plugin only registers the round type. The medley itself is built
-- and played by the game (TScreenSong.PreparePartyMedley and the existing
-- medley engine), which recognizes the mode by its name 'MicroMedley'.

function plugin_init()
  register('party mode: micromedley', '1.00', 'USDX Team', 'http://www.UltrastarDeluxe.org');

  require('Usdx.Party')

  local Mode = {}

  Mode.Name = 'MicroMedley'
  Mode.CanNonParty = false;
  Mode.CanParty = true;

  Usdx.Party.Register(Mode)

  return true;
end
