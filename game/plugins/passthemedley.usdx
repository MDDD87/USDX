-- Party mode "Pass the Medley" (SingStar style, Feature 5.2):
-- like Medley (up to 5 sections of about 30 s), but after every section the next member of each
-- team sings: the team mic is passed on (5 s lead-in). The score belongs to
-- the team. No highscores.
--
-- This plugin only registers the round type. The medley is played by the
-- game (party medley), which recognizes the mode by its name 'PassTheMedley'.

function plugin_init()
  register('party mode: pass the medley', '1.00', 'USDX Team', 'http://www.UltrastarDeluxe.org');

  require('Usdx.Party')

  local Mode = {}

  Mode.Name = 'PassTheMedley'
  Mode.CanNonParty = false;
  Mode.CanParty = true;

  Usdx.Party.Register(Mode)

  return true;
end
