-- Party mode "Pass the Mic" (teamduel): the members of each team sing the
-- song in turn, the team mic is passed on. The score belongs to the team.
--
-- Since Feature 5.3 the game itself plays this round type (recognized by the
-- name 'teamduel'): it calculates the points where the mic is passed on (after
-- every 6 to 12 percent of the notes, at the start of a lyrics line), chooses
-- the members in turn and shows the bar with the singer and "NEXT: <name>"
-- below each team (TScreenSingController.PreparePassTheMic,
-- TScreenSingView.DrawPassBars), like Pass the Medley.

function plugin_init()
  register('party mode: teamduel', '1.00', 'USDX Team', 'http://www.UltrastarDeluxe.org');

  require('Usdx.Party')

  local Mode = {}

  Mode.Name = 'teamduel';
  Mode.CanParty = true;
  Mode.PlayerCount = {2,3,4,5,6};

  Usdx.Party.Register(Mode)

  return true;
end
